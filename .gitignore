# Игнорируем всё, кроме файлов проекта: в папке могут лежать ключи,
# старые скрипты, выгрузки тренировок и база с диалогами.
/*
!/.gitignore
!/.env.example
!/README.md
!/requirements.txt
!/app.py
!/agent.py
!/tools.py
!/intervals.py
!/weather.py
!/storage.py
!/config.py
!/configure.py
!/i18n.py
!/prompts/
!/static/

# На всякий случай, даже внутри разрешённых папок
.env
*.db
__pycache__/
