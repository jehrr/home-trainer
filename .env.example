# Copy this file into .env and indicate keys

# Intervals.icu → Settings → Developer Settings → API Key
INTERVALS_API_KEY=
# Athlete id from URL, for example, i123456 
INTERVALS_ATHLETE_ID=i123456

# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Indicate models you want to use
MODEL=claude-sonnet-5
SUMMARY_MODEL=claude-haiku-4-5-20251001

# 127.0.0.1 — localhost. 
# (no password)
HOST=127.0.0.1
PORT=8765
