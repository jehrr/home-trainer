# Copy this file to .env and fill in your keys, or run:  python3 configure.py

# Interface and coach language: en or ru
LANGUAGE=en

# Intervals.icu → Settings → Developer Settings → API Key
INTERVALS_API_KEY=
# Athlete id from your Intervals.icu profile URL, e.g. i123456
INTERVALS_ATHLETE_ID=

# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Coach model and the model used to condense long conversations
MODEL=claude-sonnet-5
SUMMARY_MODEL=claude-haiku-4-5-20251001

# 127.0.0.1 = this computer only; 0.0.0.0 = reachable from your phone on the home network
# (no password: use only on a trusted network)
HOST=127.0.0.1
PORT=8765
